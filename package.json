{
  "name": "dsh-wsl-tool",
  "version": "2.0.0",
  "description": "Linux-native DSH, extended to WSL. One long-lived shell for multi-step work, a clean one for everything else; subtasks above the composer. From a WSL prompt, `dsh \"…\"` speaks into the conversation you choose and streams the reply back with thinking time; `dsh list/use/new/rm` manage sessions. Your own terminal stays in the loop — commands in view, keyboard one click away. Exit codes, path conversion, environment checks, background jobs; destructive commands ask first. Runs as you, below the DSH sandbox (it does not confine it); the in-view terminal exists up to DSH 0.2.0.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.1.7-rc.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XINY11451/dsh-wsl.git"
  },
  "homepage": "https://github.com/XINY11451/dsh-wsl#readme",
  "bugs": {
    "url": "https://github.com/XINY11451/dsh-wsl/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wsl",
    "windows",
    "linux",
    "shell",
    "interop"
  ],
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "SUPPORT.md",
    "PUBLISHING.md",
    "extras",
    "screenshots.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/client.mjs",
    "test:real": "node test/smoke.mjs --real && node test/real-seam.mjs",
    "sync": "node scripts/sync-profile.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
